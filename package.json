{
  "name": "sociograma-aula",
  "version": "2.0.0",
  "type": "module",
  "description": "Free sociometry tool for teachers",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && npm run build:manual",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:manual": "slidev build manual/slides.md --out ../dist/manual --base /SociogramaAula/manual/ --router-mode hash --with-clicks",
    "preview": "vite preview",
    "slidev": "slidev manual/slides.md"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.1",
    "vis-network": "^9.1.9",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vite": "^6.3.2",
    "vue-tsc": "^2.2.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
